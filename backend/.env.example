# ─── Servidor ───────────────────────────────
PORT=5000
# FRONTEND_URL=  (deixe vazio: no deploy o site e a API ficam no mesmo domínio)

# ─── Banco de dados ─────────────────────────
MONGODB_URI=mongodb://localhost:27017/fato-real

# ─── Autenticação ───────────────────────────
JWT_SECRET=troque_por_uma_chave_longa_e_aleatoria

# ─── News API (obrigatória para buscar fontes) ──
NEWS_API=sua-chave-da-newsapi

# ─── Google Fact Check Tools API (checagens de Lupa, Aos Fatos etc.) ──
# Gratuita. Veja o passo a passo no README/instruções. Sem ela o sistema funciona, mas sem as checagens de agências.
GOOGLE_FACTCHECK_API_KEY=sua-chave-do-google-aqui

# ─── OpenAI (opcional: camada de confirmação por IA) ──
OPENAI_API_KEY=sk-sua-chave-aqui
# AI_MODEL=gpt-4o-mini
